{
  "name": "govolley",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "test": "bun run --cwd apps/backend test --runInBand && bun run --cwd apps/frontend test",
    "test:e2e": "bun run --cwd apps/backend test:e2e",
    "test:integration": "bun run --cwd apps/backend test:integration",
    "test:db:prepare": "node scripts/test-database.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:school-time": "node scripts/training-school-time.browser.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^6.0.2",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.56.0",
    "eslint": "^9.39.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@govolley/shared-types": "workspace:*",
    "@prisma/client": "^7.10.1",
    "prisma": "^7.10.1"
  }
}
