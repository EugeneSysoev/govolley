# Origin only, without /api. Used by SSR, NextAuth and rewrites; required in production.
BACKEND_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-the-same-server-secret-as-backend
# Public map key, optional for non-map development. Restrict by domain at the provider.
NEXT_PUBLIC_MAPTILER_KEY=replace-with-public-map-key
