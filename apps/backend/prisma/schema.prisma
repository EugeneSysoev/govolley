generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  COACH
  ADMIN
}

enum SkillLevel {
  NOT_SET
  BEGINNER     // Начинающий
  INTERMEDIATE // Средний
  ADVANCED     // Продвинутый
}

enum BookingKind {
  LEGACY
  SINGLE_CASH
}

enum CancellationTiming {
  TIMELY
  LATE
}

enum AttendanceStatus {
  UNMARKED
  ATTENDED
  NO_SHOW
}

enum BookingAuditField {
  ATTENDANCE
  CASH_PAYMENT
}

model User {
  id              Int           @id @default(autoincrement())
  telegramId      String?       @unique
  username        String?       @unique // Тег в Telegram (@username)
  firstName       String?       
  lastName        String?
  avatarKey       String?
  image           String?
  
  role            Role          @default(USER)
  skillLevel      SkillLevel    @default(NOT_SET)
  isLevelVerified Boolean       @default(false)
  balance         Int           @default(0)

  // Связи
  bookings        Booking[]
  authSessions    AuthSession[]
  bookingAudits   BookingAudit[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Training {
  id                  Int           @id @default(autoincrement())
  title               String
  description         String?
  date                DateTime
  startTime           String
  endTime             String
  targetLevel         SkillLevel    @default(NOT_SET)
  maxParticipants     Int           @default(10)
  price               Float?
  location            String?
  coachName           String?
  isActive            Boolean       @default(true)

  bookings            Booking[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId  Int
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  status      String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  paymentType String   @default("CASH")      // CASH, BALANCE
  kind        BookingKind @default(LEGACY)
  cashPrice   Int?
  cancelledAt DateTime?
  cancellationTiming CancellationTiming?
  requestId   String? @db.Uuid
  attendanceStatus AttendanceStatus @default(UNMARKED)
  cashReceived Boolean?
  auditEntries BookingAudit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A partial unique index in SQL permits history, but only one CONFIRMED place.
  @@index([userId, trainingId])
  @@unique([userId, requestId])
}

model BookingAudit {
  id        Int @id @default(autoincrement())
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  requestId String @db.Uuid
  field     BookingAuditField
  oldValue  String
  newValue  String
  reason    String
  createdAt DateTime @default(now())

  @@unique([actorId, requestId])
  @@index([bookingId, id])
}

model AuthSession {
  id         String   @id @default(uuid())
  telegramId String? 
  status     String   @default("PENDING") // PENDING, CONFIRMED, CONSUMED; all expire after the shared TTL
  
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}
