{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest", "bun"],
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@govolley/shared-types": ["../../packages/shared-types/src/index.ts"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true
  },
  "include": ["src/**/*", "test/**/*", "prisma.config.ts", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
