# Server only. Supply real values locally; never commit them.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_SECRET=replace-with-a-long-random-secret-shared-with-frontend
TELEGRAM_BOT_TOKEN=replace-with-bot-token
FRONTEND_URL=http://localhost:3001
PORT=3000
# Operator-only admin:bootstrap command; exact Telegram numeric ID after first login.
# Do not expose this value through NEXT_PUBLIC_* or profile settings.
# ADMIN_TELEGRAM_ID=123456789
